{
  "name": "babe-loop",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @babeloop/server start:dev",
    "dev:web": "pnpm --filter @babeloop/web dev",
    "build": "pnpm --filter @babeloop/server schema:emit && pnpm --filter @babeloop/web build && rm -rf apps/server/public && cp -R apps/web/dist apps/server/public",
    "start": "node apps/server/dist/main.js",
    "start:worker": "node apps/server/dist/worker.js",
    "e2e:stack": "pnpm build && sh -c 'export TEXT_AI_PROVIDER=mock EMBEDDING_PROVIDER=mock OCR_PROVIDER=mock STT_PROVIDER=mock; node apps/server/dist/worker.js & exec node apps/server/dist/main.js'",
    "test": "pnpm --filter @babeloop/server test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "cleanup:dev": "tsx prisma/cleanup-dev.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "cpu-features",
      "esbuild",
      "prisma",
      "protobufjs",
      "ssh2"
    ]
  }
}
