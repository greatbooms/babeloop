# BabeLoop 나스 배포용 환경변수 — 나스 배포 경로에 `.env.prod` 이름으로 둔다.
# DATABASE_URL / REDIS_URL / OBJECT_STORAGE_(ENDPOINT|ACCESS_KEY|SECRET_KEY) / PORT는
# compose.yml이 컨테이너 안에서 주입하므로 여기 쓰지 않는다.

# Cloudflare Tunnel 토큰 (Zero Trust → Networks → Tunnels 에서 발급)
TUNNEL_TOKEN=

# ── 인프라 ──
# MinIO 자격증명 (비밀번호는 새로 생성: openssl rand -base64 24 — SECRET_KEY에 같은 값)
MINIO_ROOT_USER=babeloop
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_ACCESS_KEY=babeloop
OBJECT_STORAGE_SECRET_KEY=
# 나스의 기존 pgvector·redis 재사용 — babeloop 전용 DB·계정을 만들어 연결한다 (deploy/README 참조)
DATABASE_URL=postgresql://postgres:나스_pg_비밀번호@host.docker.internal:15432/babeloop?schema=public
# redis 논리 DB 인덱스는 'info keyspace'로 빈 번호 확인 후 확정 (기본 제안: 4)
REDIS_URL=redis://host.docker.internal:16379/4

# ── 앱 기본 ──
NODE_ENV=production
# 팀이 접속할 공개 주소 (Cloudflare Tunnel 등으로 연결한 도메인)
APP_BASE_URL=https://babeloop.eric-nas.com
# openssl rand -base64 32
SESSION_SECRET=
# 첫 기동 시드 계정 — dev 기본값 금지, 실제 쓸 값으로
ADMIN_EMAIL=
ADMIN_PASSWORD=
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# 프론트를 버셀에 분리 배포하는 경우: 버셀 도메인을 허용 오리진으로 (콤마 구분 복수 가능)
# 버셀 화면 도메인 (버셀 프로젝트 생성 후 실제 주소로)
WEB_ORIGINS=https://babeloop.vercel.app

# ── 스토리지 ──
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=babeloop
# presign 링크(이미지·영상 미리보기/다운로드)가 팀원 브라우저에서 열리는 공개 주소
# (터널에서 files.도메인 → 나스 9000 으로 라우팅)
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://files.eric-nas.com

# 사람이 배치한 로컬 IS-Net 애니 배경 제거 모델 경로 (자동 다운로드하지 않음)
CUTOUT_MODEL_PATH=/app/models/isnet-anime.onnx

# ── AI 프로바이더 (dev .env 값 그대로) ──
TEXT_AI_PROVIDER=openai
TEXT_AI_API_KEY=
TEXT_AI_MODEL=gpt-5.6-terra
TEXT_AI_USD_PER_MTOK_INPUT=1.25
TEXT_AI_USD_PER_MTOK_OUTPUT=10
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OCR_PROVIDER=openai
STT_PROVIDER=openai
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_PRICE_LOW_USD=0.04
IMAGE_PRICE_HIGH_USD=0.19
VIDEO_PROVIDER=openai
VIDEO_MODEL=sora-2
VIDEO_PRICE_PER_SECOND_USD=0.10

# ── Snowflake 성과 동기화 (키 파일은 deploy/secrets/ 에 복사) ──
SNOWFLAKE_ACCOUNT=QAVCTWB-LJ98750
SNOWFLAKE_USERNAME=BABELOOP_SYNC
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_babeloop_rsa.p8
SNOWFLAKE_ROLE=BABELOOP_R
SNOWFLAKE_WAREHOUSE=DA_WH
