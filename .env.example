NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://babeloop:babeloop@localhost:5433/babeloop
REDIS_URL=redis://localhost:6380

SESSION_SECRET=change-me-to-a-long-random-string

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=babeloop
OBJECT_STORAGE_ACCESS_KEY=babeloop
OBJECT_STORAGE_SECRET_KEY=babeloop-secret

WORKER_PORT=3001
OCR_PROVIDER=mock
# OCR_PROVIDER=openai일 때 OCR_MODEL 미설정 시 TEXT_AI_MODEL을 재사용합니다
# OCR_MODEL=
STT_PROVIDER=mock
# STT_PROVIDER=openai일 때 STT_API_KEY 미설정 시 TEXT_AI_API_KEY를 재사용합니다
# STT_API_KEY=
# STT_MODEL=whisper-1
TEXT_AI_PROVIDER=mock
# TEXT_AI_PROVIDER=openai일 때 필수 (키 값은 저장소에 기록하지 말 것)
# TEXT_AI_API_KEY=
# TEXT_AI_MODEL=
# 선택: 두 값이 모두 있을 때만 호출 비용을 계산합니다 (USD / 1M tokens)
# TEXT_AI_USD_PER_MTOK_INPUT=
# TEXT_AI_USD_PER_MTOK_OUTPUT=
EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=openai일 때 필수 (키 값은 저장소에 기록하지 말 것)
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
IMAGE_PROVIDER=mock
# IMAGE_PROVIDER=openai일 때 IMAGE_API_KEY 미설정 시 TEXT_AI_API_KEY를 재사용합니다
# IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# 이미지 1장당 예상 비용(USD)
IMAGE_PRICE_LOW_USD=0.04
IMAGE_PRICE_HIGH_USD=0.19

ADMIN_EMAIL=admin@babeloop.local
ADMIN_PASSWORD=changeme-admin

# SSRF 관문 우회 (테스트 전용 — 운영에서는 설정 금지)
# ALLOW_PRIVATE_EXTERNAL_URLS=true
# 원격 접속 시 presign 공개 주소 (선택) — 예: http://<tailscale-ip>:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=
